{
  "name": "dsh-motion-ui",
  "version": "0.5.3",
  "description": "Interactive UI, HTML/SVG animation and local calculations for DeepSeek Harness Web, with injected design guidance.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DESIGN.zh-CN.md",
    "RELEASE-PLAN.zh-CN.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "node": ">=22.19",
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorp1o117/dsh-motion-ui.git"
  },
  "homepage": "https://github.com/Scorp1o117/dsh-motion-ui#readme",
  "bugs": {
    "url": "https://github.com/Scorp1o117/dsh-motion-ui/issues"
  },
  "author": "Scorp1o117",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "generative-ui",
    "interactive-ui",
    "svg"
  ]
}
