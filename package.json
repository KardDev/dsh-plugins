{
  "name": "dsh-motion-ui",
  "version": "0.8.6",
  "description": "Readable conversational UI, interactive HTML/SVG, editable motion and local MP4 production for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "DESIGN.zh-CN.md",
    "RELEASE-PLAN.zh-CN.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
      "node": ">=22.19",
      "profiles": [
        "web",
        "desktop"
      ],
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "esbuild": "^0.25.0",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "playwright-core": "1.64.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorp1o117/dsh-motion-ui.git"
  },
  "homepage": "https://github.com/Scorp1o117/dsh-motion-ui#readme",
  "bugs": {
    "url": "https://github.com/Scorp1o117/dsh-motion-ui/issues"
  },
  "author": "Scorp1o117",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "generative-ui",
    "interactive-ui",
    "svg"
  ],
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    },
    "echarts-wordcloud": {
      "echarts": "$echarts"
    }
  }
}
