{
  "name": "dsh-cost-usage",
  "description": "Provider-agnostic cost tracking plugin for DeepSeek Harness: track LLM API spending per session by configuring per-model token pricing or auto-discovering it from provider endpoints.",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "pricing",
    "usage",
    "tracking",
    "spend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KardDev/dsh-plugins.git",
    "directory": "plugins/dsh-cost-usage"
  },
  "homepage": "https://github.com/KardDev/dsh-plugins/tree/main/plugins/dsh-cost-usage#readme",
  "bugs": {
    "url": "https://github.com/KardDev/dsh-plugins/issues"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
